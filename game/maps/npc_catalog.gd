extends RefCounted
## Preview placements are separate from appearance IDs, ready for A/C dynamic Actor data.
static func entries()->Array[Dictionary]:
	return [
		entry("holt","霍尔特","铁匠",Vector2(81,168),"手上若有好铁，就别拿它去换劣酒。我的炉火从黎明烧到日落。","铁匠铺","先看刃口，再看柄。缺口可以补，坏掉的习惯可修不了。","北桥的商队又迟了。去鸦渡镇，最好赶在暮色落下之前。"),
		entry("elena","伊莲娜","商贩 / 草药师",Vector2(244,165),"靠近些，旅人。药草得闻过才知道好坏，隔着摊布可挑不明白。","集市","鼠尾草扎成小束，干燥的叶片才不会在行囊里发霉。","黑枝林地的苔石营有人采药。出了林缘就没有路，记好河流的方向。"),
		entry("bronn","布朗","酒馆老板",Vector2(70,162),"铜鹿的炉边还有空位。先掸去靴上的泥，别把雨水带进麦酒里。","铜鹿酒馆","我照看酒窖和炉灶。来往的人带来消息，留下来的往往只有账单。","南面的枯井驿站有旧车辙。商队常在那里生火，至少还能找到避风处。"),
		entry("marta","玛尔塔","家主 / 管事",Vector2(239,181),"门闩记得扣好。镇里日子安稳，不代表每个过路人都守规矩。","民居","我照看这片院落，哪一户少了柴、哪一户屋顶漏雨，我都记得。","风磨丘在西南。磨坊人把麦袋堆在屋檐下，天气一变就忙不过来。"),
		entry("renard","雷纳","渡夫",Vector2(171,176),"河水看着平，底下却有回流。想过河就走桥，别拿性命试水深。","苇岸渡口","缆绳、船桨、船底的每一道缝，出船前都得看一遍。","北边旧王大道的桥还完整。南桥绕些路，但沿途有驿站。"),
		entry("glen","格伦","猎人",Vector2(89,94),"站在下风处，脚步放轻。林里的东西总比你先听见动静。","黑枝林地","我循着兽迹走。折枝、落毛和浅泥里的脚印，比路牌更可靠。","西北有一片湖。越过它继续向东，断墙才会从树影里显出来。"),
		entry("scott","斯科特","偷猎者",Vector2(112,89),"我只是在林里走走。你若也只是过路，就不必问我的网放在哪儿。","林中空地","弓弦怕潮，猎物怕响。别碰灌木下的绳结。","最近总有人往断誓堡搬东西。要看热闹，至少别走在火把前面。"),
		entry("leah","莉娅","采药人",Vector2(84,97),"小心脚下，那丛叶子还没长成。只摘需要的，留些给来年。","苔石猎营","雨后的根茎好挖，药性却要看季节。篮子里深浅不同的叶片不能混装。","营地向北的树下长着蘑菇。颜色鲜亮的那些，我也不会贸然入口。"),
		entry("vick","维克","山贼斥候",Vector2(181,91),"路很宽，别盯着我的斧头。你走你的，我还有自己的事。","古林边缘","在这里活着，眼睛和耳朵一样都不能闲着。","断誓堡的门早就塌了。可没有门，不等于那里欢迎客人。"),
		entry("orwen","奥尔文","迷途修士",Vector2(214,61),"愿残存的钟声为你引路。我们失去了道路，但还没有失去归处。","暮影古林","我在寻找旧修道院的名册。纸张会腐烂，名字却不该就此遗忘。","暮钟修道院在东北。若见到石门上的断钟纹样，就快到了。"),
		entry("kyra","凯拉","寻宝者",Vector2(235,50),"先看地面，再看宝箱。走过这些石阶的人，可不是都能回来讲故事。","暮钟修道院","绳子、撬杆、干燥的火绒，比一袋闪亮钱币更能帮人走出废墟。","修道院东侧有一片旧墓地。石碑排得整齐，可名字大多辨不清了。"),
		entry("severin","塞维尔","遗迹学者",Vector2(241,51),"请别踩那块刻字的石头。碑文缺了一行，但剩下的部分仍值得读。","修道院回廊","我抄录石刻，比较字形。传说不能代替证据，哪怕它流传了几百年。","断誓堡与这里的石工纹样相近。它们也许属于同一段旧王国历史。"),
		entry("morris","莫瑞斯","异教行者",Vector2(194,78),"风穿过石门时，你听见的真只是风吗？不必急着回答。","断誓堡","我留意被遗忘的符号。人们害怕它们，常常只是因为不再认识。","废墟中的紫晶会在阴影里反光。那是石头的颜色，还是别的东西，谁能说准。"),
		entry("gareth","加雷斯","佣兵掠夺者",Vector2(186,78),"把手放在我看得见的地方。废墟里遇见陌生人，总得先说清来意。","断誓堡","护送、守夜、清理旧路。我做过的活计，通常都比雇主说的更麻烦。","鸦渡镇的酒馆能打听商路消息。进镇以后，别把林里的规矩带进去。"),
		entry("gravekeeper","墓守","遗迹守卫",Vector2(267,107),"……此地安息。生者，轻声。","寂鸦墓园","……石与土，守着名字。","……钟声已断。归路，在南。")]

static func entry(key:String,title:String,role:String,tile:Vector2,greeting:String,place:String,work:String,rumor:String)->Dictionary:
	return {"id":"preview_"+key,"appearance_key":key,"name":title,"role":role,"tile":tile,"greeting":greeting,"place":place,"work":work,"rumor":rumor}
