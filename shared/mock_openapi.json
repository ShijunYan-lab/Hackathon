  "components": {
    "schemas": {
      "AdvanceRequest": {
        "properties": {
          "api_version": {
            "type": "string",
            "const": "v1",
            "title": "Api Version",
            "default": "v1"
          },
          "request_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Request Id"
          },
          "expected_world_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected World Version"
          },
          "reason": {
            "type": "string",
            "enum": [
              "idle_timer",
              "major_event",
              "rest",
              "debug_step"
            ],
            "title": "Reason"
          },
          "trigger_event_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Trigger Event Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "expected_world_version",
          "reason"
        ],
        "title": "AdvanceRequest"
      },
      "CommandRequest": {
        "properties": {
          "api_version": {
            "type": "string",
            "const": "v1",
            "title": "Api Version",
            "default": "v1"
          },
          "request_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Request Id"
          },
          "expected_world_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected World Version"
          },
          "kind": {
            "type": "string",
            "enum": [
              "CHECKPOINT",
              "HIT",
              "PICKUP",
              "EQUIP",
              "GIVE",
              "ACCEPT_OFFER",
              "CHANGE_REGION",
              "TASK_REPORT",
              "JOIN_ORG",
              "LEAVE_ORG"
            ],
            "title": "Kind"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "expected_world_version",
          "kind",
          "payload"
        ],
        "title": "CommandRequest"
      },
      "DialogueRequest": {
        "properties": {
          "api_version": {
            "type": "string",
            "const": "v1",
            "title": "Api Version",
            "default": "v1"
          },
          "request_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Request Id"
          },
          "expected_world_version": {
            "type": "integer",
            "minimum": 0.0,
